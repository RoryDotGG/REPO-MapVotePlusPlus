<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MapVote</AssemblyName>
    <RootNamespace>MapVote</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Rory Durrant</Authors>
    <RepositoryUrl>https://github.com/RoryDotGG/REPO-MapVote</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Set this (e.g. in Directory.Build.props) to auto-copy the DLL into a BepInEx profile. -->
    <PluginsDir Condition="'$(PluginsDir)' == ''"></PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="0.4.4-ngd.0" PrivateAssets="all" />
    <PackageReference Include="Zehs.REPOLib" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(PluginsDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/MapVote" />
  </Target>
</Project>
