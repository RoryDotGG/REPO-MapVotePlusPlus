<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MapVotePlusPlus</AssemblyName>
    <RootNamespace>MapVote</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Rory Durrant</Authors>
    <RepositoryUrl>https://github.com/RoryDotGG/REPO-MapVotePlusPlus</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <!-- GameLibs is publicised, so private game members compile. This marks the module unverifiable,
         which makes the game's Mono skip its access checks (otherwise FieldAccessException at runtime). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Set this (e.g. in Directory.Build.props) to auto-copy the DLL into a BepInEx profile. -->
    <PluginsDir Condition="'$(PluginsDir)' == ''"></PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="0.4.4-ngd.0" PrivateAssets="all" />
    <PackageReference Include="Zehs.REPOLib" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- MenuLib isn't on NuGet, so fetch the pinned Thunderstore release at build time. It's GPL-3.0, so it isn't committed here. -->
  <PropertyGroup>
    <MenuLibVersion>2.6.0</MenuLibVersion>
    <MenuLibDir>$(MSBuildProjectDirectory)/obj/thunderstore/MenuLib-$(MenuLibVersion)</MenuLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MenuLib" HintPath="$(MenuLibDir)/MenuLib.dll" Private="false" />
  </ItemGroup>
  <Target Name="FetchMenuLib" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(MenuLibDir)/MenuLib.dll')">
    <DownloadFile SourceUrl="https://thunderstore.io/package/download/REPOModding/MenuLib/$(MenuLibVersion)/"
                  DestinationFolder="$(MenuLibDir)" DestinationFileName="MenuLib.zip" />
    <Unzip SourceFiles="$(MenuLibDir)/MenuLib.zip" DestinationFolder="$(MenuLibDir)" />
  </Target>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(PluginsDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/MapVotePlusPlus" />
  </Target>

  <!-- Thunderstore zip: dotnet build -c Release -t:ThunderstorePackage. Files sit at the zip root; mod managers put the DLL in BepInEx/plugins. -->
  <Target Name="ThunderstorePackage" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageStageDir>$(MSBuildProjectDirectory)/obj/package</PackageStageDir>
      <PackageZip>$(MSBuildProjectDirectory)/dist/$(AssemblyName)-$(Version).zip</PackageZip>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/manifest.json')), '(?&lt;="version_number"\s*:\s*")[^"]+'))</ManifestVersion>
      <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/src/Plugin.cs')), '(?&lt;=const string Version = ")[^"]+'))</PluginVersion>
    </PropertyGroup>
    <Error Condition="'$(Configuration)' != 'Release'" Text="Package a Release build: dotnet build -c Release -t:ThunderstorePackage" />
    <Error Condition="'$(ManifestVersion)' != '$(Version)' Or '$(PluginVersion)' != '$(Version)'"
           Text="Version mismatch: csproj $(Version), manifest.json '$(ManifestVersion)', Plugin.cs '$(PluginVersion)'. Bump all three." />
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="manifest.json;icon.png;README.md;CHANGELOG.md;LICENSE;$(TargetPath)" DestinationFolder="$(PackageStageDir)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/dist" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>
</Project>
